# CloudNova PaymentOps — public marketing website environment (placeholders only).
# Never commit real secrets. Copy to `.env.local` for local development.

# Public site URL — used for canonical URLs, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://paymentops.cloudnova.tech

# Private authenticated application URL — the Sign In target.
NEXT_PUBLIC_APP_URL=https://paymentops-app.cloudnova.tech

# Google Analytics 4 measurement id.
# When empty, no analytics tag is rendered and analytics helpers are no-ops.
# In containers prefer the runtime (non-inlined) GA_MEASUREMENT_ID; NEXT_PUBLIC_ is for local dev.
GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (server-side only). Leave empty until supplied.
GOOGLE_SITE_VERIFICATION=

# Demo-request delivery webhook (server-side only).
# When unset, demo requests are durably recorded as structured server logs (never discarded).
DEMO_REQUEST_WEBHOOK_URL=
